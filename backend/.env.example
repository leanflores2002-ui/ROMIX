# Database (prefer DATABASE_URL, else DB_* parts)
# DATABASE_URL=mysql+pymysql://user:password@host:3306/romix?charset=utf8mb4
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=pass
DB_NAME=romix

# Notifications
# Preferred provider: whatsapp or telegram (optional)
NOTIFICATION_PROVIDER=whatsapp

# CallMeBot (WhatsApp)
CALLMEBOT_PHONE=+5491112345678
CALLMEBOT_API_KEY=YOUR_CALLMEBOT_API_KEY

# Telegram
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# CORS (comma-separated). Use * for any origin.
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# Logging
LOG_LEVEL=INFO

