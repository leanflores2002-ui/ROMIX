  },
  "homepage": "https://github.com/Leandro18122022/web#readme",
  "devDependencies": {
    "axe-core": "^4.11.0",
    "jsdom": "^27.3.0",
    "lucide": "^0.468.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2"
  }
}
