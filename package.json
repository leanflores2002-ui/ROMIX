{
  "name": "web",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "pretest": "node scripts/sync-storefront-shells.js",
    "build": "node scripts/generate-share-pages.js",
    "test:templates": "node tests/storefrontTemplateTests.js",
    "test": "node scripts/test-suite.js",
    "test:buttons": "node tests/romixIconButtonTests.js",
    "test:season-backend": "python tests/season_visibility_backend_tests.py",
    "test:share-backend": "python tests/product_share_backend_tests.py",
    "test:share": "node tests/sharePreviewTests.js",
    "test:media": "node tests/mediaStorageTests.js",
    "test:security": "node tests/shareSecurityTests.js",
    "test:seo": "node tests/seoTests.js && node tests/categoryPagesTests.js",
    "test:orders": "python -m pytest backend/tests/test_orders.py -q -p no:cacheprovider",
    "audit:storage": "node scripts/measure-storage.js",
    "audit:product-media": "node scripts/audit-product-media.js",
    "optimize:products": "node scripts/optimize-product-images.js",
    "optimize:storefront": "node scripts/optimize-storefront-images.js",
    "storage:migration:dry-run": "node scripts/catalog-media.js",
    "check:products": "node scripts/check-products.js",
    "compact:products": "node scripts/compact-products.js --write",
    "compact:products:preview": "node scripts/compact-products.js",
    "sync:price-groups": "node scripts/addPriceByGroupPlaceholder.js",
    "generate:share-pages": "node scripts/generate-share-pages.js",
    "generate:icons": "node scripts/generate-romix-icons.js",
    "sync:shells": "node scripts/sync-storefront-shells.js",
    "build:ts": "tsc -p tsconfig.json",
    "check:ts": "tsc -p tsconfig.json --noEmit",
    "test:performance": "node tests/productDerivativeTests.js",
    "test:regressions": "node tests/analyticsTests.js && node tests/sharePriceTests.js && node tests/cartPersistenceTests.js",
    "test:browser": "node tests/commerceBrowserTests.js && node tests/megaMenuBrowserTests.js",
    "test:backend": "python -m pytest backend/tests/test_orders.py -q -p no:cacheprovider && python tests/season_visibility_backend_tests.py && python tests/product_share_backend_tests.py && python tests/seo_backend_tests.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leandro18122022/web.git"
  },
